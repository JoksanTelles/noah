,"src":"https://cdn.grapesjs.com/workspaces/cmh32kklt12wfduapkc0ahcl1/assets/7f3ad023-86e8-444a-b3f4-1ce76b736247__noahpag34.png","id":"icto2"},"custom-name":"cocodrilo_03"},{"type":"image","resizable":{"ratioDefault":1},"attributes":{"alt":"noah__pag_3_6.png","src":"https://cdn.grapesjs.com/workspaces/cmh32kklt12wfduapkc0ahcl1/assets/4a24c8a7-3356-4a60-ab38-783b18010d19__noahpag36.png","id":"ie2pt"},"custom-name":"cocodrilo_04"}],"custom-name":"container"}],"custom-name":"section_3"},{"type":"section","classes":["gjs-section"],"attributes":{"id":"ikweb"},"components":[{"type":"container","classes":["gjs-container"],"attributes":{"id":"ii5ng"},"components":[{"type":"image","resizable":{"ratioDefault":1},"attributes":{"alt":"section(1).png","src":"https://cdn.grapesjs.com/workspaces/cmh32kklt12wfduapkc0ahcl1/assets/f05e28e9-2436-4857-9adf-2d35f18e01ce__section41.png","id":"ijvbk"},"custom-name":"fondo"},{"type":"flex-row","classes":["gjs-plg-flex-row"],"attributes":{"data-type-role":"flex-row","id":"i5so7"},"components":[{"type":"flex-column","classes":["gjs-plg-flex-column"],"attributes":{"data-type-role":"flex-column","id":"i2wu6"},"components":[{"tagName":"em","type":"text","attributes":{"id":"iicyk"},"components":[{"type":"textnode","content":"Nos alegra contar con tu presencia en este día tan especial; si deseas acompañarla con un detalle, aquí encontrarás algunas sugerencias."}]},{"type":"imageBox","classes":["gjs-image-box"],"attributes":{"id":"il6a6"},"src":"https://cdn.grapesjs.com/workspaces/cmh32kklt12wfduapkc0ahcl1/assets/2976ad82-a77a-4cfd-88e4-355902dc8c66__amazon-logo-1.png"},{"type":"linkBox","classes":["gjs-link-box"],"attributes":{"href":"https://www.amazon.com.mx/registries/gl/guest-view/2GI233XIFAWFO","id":"i1lsj"},"components":[{"type":"button","attributes":{"type":"button","id":"ifzrb"},"components":[{"type":"textnode","content":"Ver mesa de regalo"}]}]}]}],"snap":"","snap-divisions":12},{"type":"image","resizable":{"ratioDefault":1},"attributes":{"id":"i2662","src":"https://cdn.grapesjs.com/workspaces/cmh32kklt12wfduapkc0ahcl1/assets/e0ee89fc-07c3-4a2f-9e34-d3565300ffb4__abejita-plim-plim-png.png"}},{"type":"image","resizable":{"ratioDefault":1},"attributes":{"id":"i2662-2","src":"https://cdn.grapesjs.com/workspaces/cmh32kklt12wfduapkc0ahcl1/assets/7dad4804-8c55-4c08-9df6-a17e31378e31__wichi-wi-plim-plim-png.png"}}],"custom-name":"container"}],"custom-name":"section_4"},{"type":"section","classes":["gjs-section"],"attributes":{"id":"ikweb-3"},"components":[{"type":"container","classes":["gjs-container"],"attributes":{"id":"ii5ng-3"},"components":[{"type":"image","resizable":{"ratioDefault":1},"attributes":{"alt":"section(1).png","src":"https://cdn.grapesjs.com/workspaces/cmh32kklt12wfduapkc0ahcl1/assets/6fbc619d-8f30-4528-b3f4-8a98cb1918aa__section51.png","id":"ijvbk-3"},"custom-name":"fondo"},{"type":"linkBox","classes":["gjs-link-box"],"attributes":{"href":"https://api.whatsapp.com/send/?phone=522294531400&text=Hola...","id":"ikooq"},"components":[{"type":"button","attributes":{"type":"button","id":"ij2kf"},"components":[{"type":"textnode","content":"Confirmar asistencia"}]}]},{"type":"image","resizable":{"ratioDefault":1},"attributes":{"id":"i2662-2-2","src":"https://cdn.grapesjs.com/workspaces/cmh32kklt12wfduapkc0ahcl1/assets/7dad4804-8c55-4c08-9df6-a17e31378e31__wichi-wi-plim-plim-png.png"}}],"custom-name":"container"}],"custom-name":"section_5"},{"type":"section","classes":["gjs-section"],"attributes":{"id":"iiq6gu"},"components":[{"type":"container","classes":["gjs-container"],"attributes":{"id":"ik2lz7"},"components":[{"tagName":"span","type":"text","attributes":{"id":"ig972t"},"components":[{"type":"textnode","content":"Hecho con ❤️ por Mary y Joksan"}]}]}]},{"type":"script","components":[{"type":"textnode","content":"\n      'use strict';\n\n      // Utilidades seguras (sin prototipos)\n      function getOrInsert(map, key, make) {\n        if (!map.has(key)) map.set(key, make(key));\n        return map.get(key);\n      }\n\n      function getOrInsertComputed(map, key, compute) {\n        let v = map.get(key);\n        if (v === undefined) {\n          v = compute(key);\n          map.set(key, v);\n        }\n        return v;\n      }\n\n      // Espera a que existan elementos por ID. Observa el DOM si aún no están.\n      function onElementsReady(ids, cb, timeoutMs = 10000) {\n        const found = () => ids.map(id => document.getElementById(id));\n        let nodes = found();\n        if (nodes.every(Boolean)) {\n          cb(...nodes);\n          return;\n        }\n\n        const observer = new MutationObserver(() => {\n          nodes = found();\n          if (nodes.every(Boolean)) {\n            observer.disconnect();\n            cb(...nodes);\n          }\n        });\n        observer.observe(document.documentElement || document.body, {\n          childList: true,\n          subtree: true\n        });\n\n        // Freno de seguridad\n        setTimeout(() => observer.disconnect(), timeoutMs);\n      }\n\n      function initCountdown(d, h, m, s, targetISO) {\n        const targetMs = Date.parse(targetISO);\n        if (!Number.isFinite(targetMs)) return;\n\n        const tick = () => {\n          const dist = targetMs - Date.now();\n          if (dist <= 0) {\n            clearInterval(timer);\n            d.textContent = h.textContent = m.textContent = s.textContent = '0';\n            return;\n          }\n          const dias = Math.floor(dist / 86400000);\n          const horas = Math.floor((dist % 86400000) / 3600000);\n          const minutos = Math.floor((dist % 3600000) / 60000);\n          const segundos = Math.floor((dist % 60000) / 1000);\n          d.textContent = String(dias);\n          h.textContent = String(horas);\n          m.textContent = String(minutos);\n          s.textContent = String(segundos);\n        };\n        tick();\n        const timer = setInterval(tick, 1000);\n        return timer;\n      }\n\n      function initPlayer(audio, btn, time) {\n        const fmt = t => {\n          if (!Number.isFinite(t)) return '00:00';\n          const m = Math.floor(t / 60);\n          const s = Math.floor(t % 60);\n          return String(m).padStart(2, '0') + ':' + String(s).padStart(2, '0');\n        };\n        const updateTime = () => {\n          time.textContent = `${fmt(audio.currentTime)} / ${fmt(audio.duration)}`;\n        };\n        const setState = playing => {\n          // btn.textContent = playing ? '❚❚' : '▶︎';\n          btn.setAttribute('aria-label', playing ? 'Pausar' : 'Reproducir');\n        };\n\n        btn.addEventListener('click', () => {\n          if (audio.paused) audio.play().catch(() => {});\n          else audio.pause();\n        });\n        audio.addEventListener('play', () => setState(true));\n        audio.addEventListener('pause', () => setState(false));\n        audio.addEventListener('ended', () => {\n          audio.currentTime = 0;\n          setState(false);\n          updateTime();\n        });\n        audio.addEventListener('timeupdate', updateTime);\n        audio.addEventListener('loadedmetadata', updateTime);\n\n        setState(false);\n        updateTime();\n      }\n\n      // Arranque seguro tras DOM listo y con espera de nodos\n      document.addEventListener('DOMContentLoaded', () => {\n        // Reproductor\n        onElementsReady(['audio', 'playPauseBtn', 'time'], (audio, btn, time) => {\n          initPlayer(audio, btn, time);\n        });\n\n        // Countdown\n        onElementsReady(['iwacl', 'i1swv', 'ipacj', 'ihbsl'], (d, h, m, s) => {\n          initCountdown(d, h, m, s, '2025-11-16T15:00:00');\n        });\n      });\n      document.addEventListener('DOMContentLoaded', () => {\n        document.querySelector('a[aria-label=\"Created in Grapes Studio\"]').style.display = 'none !important';\n      });\n    "}]}],"doctype":"<!DOCTYPE html>","head":{"type":"head","components":[{"tagName":"title","type":"text","components":[{"type":"textnode","content":"Home"}]},{"tagName":"meta","void":true,"attributes":{"charset":"utf-8"}},{"tagName":"meta","void":true,"attributes":{"name":"viewport","content":"width=device-width,initial-scale=1"}},{"tagName":"meta","void":true,"attributes":{"name":"robots","content":"index,follow"}},{"tagName":"meta","void":true,"attributes":{"name":"generator","content":"GrapesJS Studio"}}]},"docEl":{"tagName":"html"}},"id":"pDJ9PTSmaLl32bTO","minHeight":"500px"}],"id":"0ToiNh7W5isNyLsw"}],"symbols":[],"custom":{"projectType":"web","id":"","globalPageSettings":{"fonts":{"Montaga":{"family":"Montaga","familyLabel":"Montaga","menuVariant":{"family":"menuFont-Montaga","variant":"regular","source":"https://fonts.gstatic.com/s/montaga/v13/H4cnBX2Ml8rCkEO_4gca7Q.woff2"},"variants":{"regular":{"family":"Montaga","variant":"regular","source":"https://fonts.gstatic.com/s/montaga/v13/H4cnBX2Ml8rCkEO_0gMQ7LO5mqc.woff2","descriptors":{"weight":"400"}}}},"Fraunces":{"family":"Fraunces","familyLabel":"Fraunces","menuVariant":{"family":"menuFont-Fraunces","variant":"regular","source":"https://fonts.gstatic.com/s/fraunces/v38/6NUh8FyLNQOQZAnv9bYEvDiIdE9Ea92uemAk_WBq8U_9v0c2Wa0K7iN7hzFUPJH58nib1603gg7S2nfgRYIctxuTD_7T.woff2"},"variants":{"regular":{"family":"Fraunces","variant":"regular","source":"https://fonts.gstatic.com/s/fraunces/v38/6NUV8FyLNQOQZAnv9awKnugMyM1A.woff2","descriptors":{"weight":"100 900"}},"italic":{"family":"Fraunces","variant":"italic","source":"https://fonts.gstatic.com/s/fraunces/v38/6NUT8FyLNQOQZAnv9ZwNlOkuzd1AZtw.woff2","descriptors":{"style":"italic","weight":"100 900"}}}},"'Readex Pro'":{"family":"'Readex Pro'","familyLabel":"Readex Pro","menuVariant":{"family":"'menuFont-Readex Pro'","variant":"regular","source":"https://fonts.gstatic.com/s/readexpro/v27/SLXnc1bJ7HE5YDoGPuzj_dh8uc7wUy8ZQQyX2KY8TL0kGZN6blTC4USWg2Eh.woff2"},"variants":{"regular":{"family":"'Readex Pro'","variant":"regular","source":"https://fonts.gstatic.com/s/readexpro/v27/SLXNc1bJ7HE5YDoGPuzj59ZebXZkiSo.woff2","descriptors":{"weight":"160 700"}}}}}}}}